TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=

# Ключ Anthropic API для AI-суммаризации постов (получить: https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Номер телефона userbot-аккаунта (нужен только для auth_step1.py)
TELEGRAM_PHONE=

# Чат, куда слать лиды (твой личный chat_id или группа)
TELEGRAM_TARGET_CHAT_ID=

# Список chat_id через запятую, кому разрешены команды бота.
# Если не задано — разрешается только TELEGRAM_TARGET_CHAT_ID.
ADMIN_CHAT_IDS=

# Настройки хранилища и сессий
DATABASE_PATH=data/leads.sqlite3
USER_SESSION_PATH=sessions/freelancer_user
BOT_SESSION_PATH=sessions/freelancer_delivery_bot

# Сколько старых сообщений подгружать при старте
CATCH_UP_LIMIT=25
SEND_CATCH_UP=true

LOG_LEVEL=INFO

# Кому разрешена регистрация через бота (username через запятую, без @)
# Если не задано — регистрация открыта для всех
# Пример: ALLOWED_USERNAMES=ivan,maria,john
ALLOWED_USERNAMES=
